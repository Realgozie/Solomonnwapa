{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": {
      "@/components/*": ["./src/components/*"],
      "@/content/*": ["./src/content/*"],
      "@/lib/*": ["./src/lib/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/app/**/*.ts",
    "src/app/**/*.tsx",
    "src/content/**/*.ts",
    "src/components/layout.tsx",
    "src/components/site-header.tsx",
    "src/components/site-footer.tsx",
    "src/lib/metadata.ts",
    "src/lib/site-url.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
